# TapatShop environment
#
# Copy to `.env` in the repo root. That one file serves the whole monorepo — apps/web loads
# it from next.config.ts, and Prisma reads it from the root too. Never commit a filled-in copy.

# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=TapatShop

# ── Database ──────────────────────────────────────────────────────────
# In production the app user must NOT have DROP privilege, and migrations run as a
# separate user. Locally both databases are created by docker/mysql/init.
#
# These credentials match the defaults in docker/docker-compose.yml. Compose does not read
# this file — it has its own defaults baked in — so if you change one, change both.
DATABASE_URL="mysql://tapat:password@localhost:3306/tapatshop"
SHADOW_DATABASE_URL="mysql://tapat:password@localhost:3306/tapatshop_shadow"

# Integration tests run against their own database so a test run cannot wipe your dev data.
# Create it with scripts/setup-local-mysql.sql, then `pnpm db:test:prepare`. Integration
# tests skip themselves when this is unset, so unit tests still run without a database.
TEST_DATABASE_URL="mysql://tapat:password@localhost:3306/tapatshop_test"

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

SESSION_MAX_AGE_DAYS=30
ADMIN_SESSION_MAX_AGE_HOURS=12

# ── PayMongo ──────────────────────────────────────────────────────────
# Test keys start with sk_test_ / pk_test_. Never put a live key in a dev file.
PAYMONGO_SECRET_KEY="sk_test_"
PAYMONGO_PUBLIC_KEY="pk_test_"
# From the webhook you register — used to verify the raw-body signature.
PAYMONGO_WEBHOOK_SECRET=""
PAYMONGO_API_URL="https://api.paymongo.com/v1"

# ── Media (MinIO locally, R2 or MinIO in production) ──────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="tapatshop-media"
# Locally these are the MinIO root credentials from docker/docker-compose.yml.
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_MEDIA_BASE_URL="http://localhost:9000/tapatshop-media"

# ── Email ─────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="TapatShop <orders@tapatshop.com>"
EMAIL_REPLY_TO="support@tapatshop.com"

# ── SMS / OTP ─────────────────────────────────────────────────────────
SMS_PROVIDER="semaphore"
SMS_API_KEY=""
SMS_SENDER_NAME="TapatShop"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3

# ── Business rules ────────────────────────────────────────────────────
CART_TTL_DAYS=30
STOCK_RESERVATION_TTL_SECONDS=900

# Shared secret for the internal cron endpoints. Generate with: openssl rand -base64 32
# Without it the sweeper refuses to run rather than accepting unauthenticated calls.
#   */5 * * * * curl -fsS -X POST -H "x-cron-secret: $CRON_SECRET" \
#     https://tapatshop.com/api/v1/internal/sweep-reservations
CRON_SECRET=""
LOW_STOCK_DEFAULT_THRESHOLD=5

# No VAT settings. The store is non-VAT registered and the price shown is the price paid.
# See docs/01-product-spec.md before adding any.

# Member pricing is NOT an env var — it is the `member_discount_percent` row in `settings`,
# so an admin can change it without a deploy. See docs/01-product-spec.md.

# ── Observability ─────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
LOG_LEVEL=info

# ── Local webhook testing ─────────────────────────────────────────────
# Expose localhost so PayMongo can reach the webhook endpoint:
#   cloudflared tunnel --url http://localhost:3000
# Then register that URL in the PayMongo dashboard for test mode.
