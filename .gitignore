# Secrets — .env.example is the only env file that may be committed
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
out/
next-env.d.ts

# Build output
dist/
build/
*.tsbuildinfo

# Test and coverage
coverage/
.vitest/

# Prisma — the client is generated, never committed
packages/db/generated/
packages/db/prisma/*.db
packages/db/prisma/*.db-journal

# Local data volumes (Docker Compose)
docker/data/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code — local overrides stay local
.claude/settings.local.json
