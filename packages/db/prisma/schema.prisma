// TapatShop — data model
// All money is Int centavos. All timestamps stored UTC.

generator client {
  provider = "prisma-client-js"

  // Generated into the package rather than node_modules so the output survives a pnpm
  // prune and so both apps/web and the seed script resolve the same client.
  output = "../generated/client"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─────────────────────────────  enums  ─────────────────────────────

enum Role {
  customer
  staff
  admin
}

enum ProductStatus {
  draft
  active
  archived
}

enum OrderStatus {
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  unpaid
  awaiting_payment
  paid
  partially_refunded
  refunded
  failed
}

enum FulfillmentStatus {
  unfulfilled
  packed
  shipped
  delivered
  returned
}

enum MovementReason {
  sale
  restock
  adjustment
  cancellation
  refund_return
  damage
}

enum CouponType {
  percentage
  fixed
  free_shipping
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum OtpPurpose {
  account_recovery
  phone_verification
}

// One token table serves both flows, so each row must say which flow it belongs to.
// Without this, a 24-hour email verification link — the kind that gets forwarded, logged,
// and left sitting in an inbox — would also work as a password reset token.
enum TokenPurpose {
  email_verification
  password_reset
}

enum RecoveryStatus {
  pending
  approved
  confirmed
  rejected
}

// ─────────────────────────────  identity  ─────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  emailVerifiedAt DateTime?
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  recoveryEmail   String?
  passwordHash    String?
  role            Role      @default(customer)

  memberNo         String?   @unique
  chapter          String?
  memberVerifiedAt DateTime?

  marketingOptIn Boolean   @default(false)
  privacyAgreedAt DateTime?
  lastLoginAt    DateTime?
  disabledAt     DateTime?

  // Sessions are JWTs, so there is nothing server-side to delete when we need to revoke one.
  // Instead every token carries its issue time and is rejected if issued before this stamp.
  // Set on password reset and on email change, per docs/07-auth-and-recovery.md.
  sessionsRevokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  addresses      Address[]
  carts          Cart[]
  orders         Order[]
  resetTokens    PasswordResetToken[]
  otpCodes       OtpCode[]
  reviews        Review[]
  wishlistItems  WishlistItem[]
  notifications  Notification[]
  auditLogs      AuditLog[]        @relation("AuditActor")
  movements      InventoryMovement[]
  recoveryRequests AccountRecoveryRequest[] @relation("RecoverySubject")
  recoveryReviews  AccountRecoveryRequest[] @relation("RecoveryReviewer")

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// Auth.js account linking. One user may have both a password and a Google link.
model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  type              String
  accessToken       String? @db.Text
  refreshToken      String? @db.Text
  expiresAt         Int?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Single-use tokens for email verification and password reset. Only the hash is stored.
model PasswordResetToken {
  id        String       @id @default(cuid())
  userId    String
  tokenHash String       @unique
  purpose   TokenPurpose @default(password_reset)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("password_reset_tokens")
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  phone     String
  codeHash  String
  purpose   OtpPurpose
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

/**
 * Admin-assisted account recovery — docs/07 route 3, the last resort.
 *
 * For the customer who has lost the Gmail account their login depends on. The whole design
 * is a deliberate paper trail: the customer states what they can prove, an admin checks it
 * against real order history, and the only thing an approval does is send a confirmation
 * link to the NEW address. No admin ever sets or sees a password.
 */
model AccountRecoveryRequest {
  id     String  @id @default(cuid())
  // Set once an admin matches the claim to an account. Null while unmatched.
  userId String?

  // What the customer claims, in their words. Never trusted, only compared.
  claimedName     String
  claimedEmail    String?
  claimedMemberNo String?
  claimedOrderNo  String?
  claimedAddress  String? @db.Text

  /** Where they want their login moved to. Only ever written after an admin approves. */
  newEmail String

  status     RecoveryStatus @default(pending)
  reviewNote String?        @db.Text

  // The confirmation link. Hashed, like every other token in this schema.
  tokenHash String?   @unique
  expiresAt DateTime?

  reviewedById String?
  reviewedAt   DateTime?
  confirmedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User? @relation("RecoverySubject", fields: [userId], references: [id], onDelete: SetNull)
  reviewer User? @relation("RecoveryReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@map("account_recovery_requests")
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String?
  recipient  String
  phone      String
  region     String
  province   String
  city       String
  barangay   String
  street     String  @db.Text
  postalCode String?
  isDefault  Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────  catalog  ─────────────────────────────

model Category {
  id          String  @id @default(cuid())
  parentId    String?
  name        String
  slug        String  @unique
  description String? @db.Text
  imageUrl    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  categoryId  String?
  name        String
  slug        String        @unique
  brand       String?
  description String?       @db.Text
  status      ProductStatus @default(draft)
  isFeatured  Boolean       @default(false)
  memberOnly  Boolean       @default(false)

  metaTitle       String?
  metaDescription String? @db.Text

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category Category?        @relation(fields: [categoryId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]
  reviews  Review[]
  wishlist WishlistItem[]

  @@index([status, isFeatured])
  @@index([categoryId])
  @@fulltext([name, brand, description])
  @@map("products")
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  sku       String @unique
  name      String // e.g. "Large / Navy". Use "Default" for single-variant products.

  optionValues Json? // { size: "L", color: "Navy" }

  // Member pricing is a store-wide percentage (the `member_discount_percent` setting),
  // not a per-variant price. See docs/01-product-spec.md. Deliberately no memberPriceCents.
  priceCents          Int
  compareAtPriceCents Int?
  costCents           Int?

  stockQty           Int @default(0)
  lowStockThreshold  Int @default(5)
  weightGrams        Int @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  movements    InventoryMovement[]
  reservations StockReservation[]

  @@index([productId])
  @@index([stockQty])
  @@map("product_variants")
}

// ─────────────────────────────  cart  ─────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  userId     String?
  guestToken String?  @unique

  // The code only. The discount itself is recomputed on every read from the live coupon
  // row, so an expired or exhausted code stops applying without anything having to update
  // the cart.
  couponCode String?

  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  addedAt   DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// Redis holds the live reservation; this table is the durable audit copy.
model StockReservation {
  id        String   @id @default(cuid())
  variantId String
  orderId   String?
  quantity  Int
  expiresAt DateTime
  releasedAt DateTime?
  createdAt DateTime @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, expiresAt])
  @@map("stock_reservations")
}

// ─────────────────────────────  orders  ─────────────────────────────

model Order {
  id      String @id @default(cuid())
  orderNo String @unique // TS-2026-000123
  userId  String?

  guestEmail String?

  status            OrderStatus       @default(pending)
  paymentStatus     PaymentStatus     @default(unpaid)
  fulfillmentStatus FulfillmentStatus @default(unfulfilled)

  // No VAT column by design. The store is non-VAT registered and prices are the price —
  // see docs/01-product-spec.md. A permanently-zero column invites someone to start
  // populating it and quietly break invariant I1.
  subtotalCents Int
  shippingCents Int @default(0)
  discountCents Int @default(0)
  totalCents    Int
  refundedCents Int @default(0)

  couponCode String?

  // Immutable snapshot of the delivery address at time of order.
  shippingAddress Json
  customerName    String
  customerEmail   String
  customerPhone   String

  shippingMethod String?
  trackingNumber String?
  carrier        String?

  customerNote String? @db.Text
  adminNote    String? @db.Text

  placedAt    DateTime?
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?       @relation(fields: [userId], references: [id])
  items     OrderItem[]
  payments  Payment[]
  refunds   Refund[]
  movements InventoryMovement[]
  events    OrderEvent[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([customerEmail])
  @@map("orders")
}

// Snapshot. Never join to live product data for historical orders.
model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String?

  productName String
  variantName String
  sku         String
  imageUrl    String?

  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String // status_changed, payment_received, shipped, note_added
  message   String   @db.Text
  actorId   String?
  isPublic  Boolean  @default(true) // shown on the customer timeline
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_events")
}

// ─────────────────────────────  payments  ─────────────────────────────

model Payment {
  id      String @id @default(cuid())
  orderId String

  provider          String  @default("paymongo")
  checkoutSessionId String? @unique
  paymentIntentId   String?
  providerPaymentId String? @unique

  method      String? // gcash, card, maya, grab_pay, dob, qrph
  amountCents Int
  feeCents    Int?
  netCents    Int?
  status      String // pending, paid, failed, refunded

  rawPayload Json?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id        String @id @default(cuid())
  orderId   String
  paymentId String?

  providerRefundId String? @unique
  amountCents      Int
  reason           String
  status           String // pending, succeeded, failed
  restockItems     Boolean @default(true)

  actorId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@map("refunds")
}

// Every inbound webhook, recorded before processing. Idempotency key.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("paymongo")
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?
  error       String?   @db.Text
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("webhook_events")
}

// ─────────────────────────────  inventory  ─────────────────────────────

// The ledger. stock_qty on the variant is a derived cache of this table.
model InventoryMovement {
  id        String         @id @default(cuid())
  variantId String
  delta     Int // negative for sale, positive for restock
  reason    MovementReason
  orderId   String?
  actorId   String?
  note      String?        @db.Text
  balanceAfter Int
  createdAt DateTime       @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id])
  actor   User?          @relation(fields: [actorId], references: [id])

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

// ─────────────────────────────  promotions  ─────────────────────────────

model Coupon {
  id                String     @id @default(cuid())
  code              String     @unique
  type              CouponType
  valueCents        Int? // for fixed
  percentage        Int? // for percentage, 1-100
  minSubtotalCents  Int        @default(0)
  maxUses           Int?
  maxUsesPerUser    Int        @default(1)
  usedCount         Int        @default(0)
  membersOnly       Boolean    @default(false)
  startsAt          DateTime?
  endsAt            DateTime?
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  userId        String?
  orderId       String
  discountCents Int
  createdAt     DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([orderId])
  @@map("coupon_redemptions")
}

// ─────────────────────────────  shipping  ─────────────────────────────

model ShippingZone {
  id        String   @id @default(cuid())
  name      String // Metro Manila, Luzon, Visayas, Mindanao
  regions   Json // ["NCR", "Region III"]
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  rates ShippingRate[]

  @@map("shipping_zones")
}

model ShippingRate {
  id        String @id @default(cuid())
  zoneId    String
  name      String // Standard, Express
  baseCents Int
  perKgCents Int  @default(0)
  freeAboveCents Int?
  etaDaysMin Int  @default(2)
  etaDaysMax Int  @default(5)
  isActive  Boolean @default(true)

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@map("shipping_rates")
}

// ─────────────────────────────  content & misc  ─────────────────────────────

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String
  orderId   String? // verified purchase if set
  rating    Int // 1-5
  title     String?
  body      String?      @db.Text
  status    ReviewStatus @default(pending)
  createdAt DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  placement String   @default("home_hero")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?

  @@map("banners")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // order_shipped, back_in_stock, promo
  title     String
  body      String    @db.Text
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id       String @id @default(cuid())
  actorId  String?
  action   String // product.update, order.refund, user.role_change
  entity   String
  entityId String
  before   Json?
  after    Json?
  ip       String?
  userAgent String? @db.Text
  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}
