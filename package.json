{
  "name": "tapatshop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tapatshop/web dev",
    "build": "pnpm --filter @tapatshop/web build",
    "start": "pnpm --filter @tapatshop/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "dotenv -e .env -- pnpm --filter @tapatshop/db exec prisma generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @tapatshop/db exec prisma migrate dev",
    "db:deploy": "dotenv -e .env -- pnpm --filter @tapatshop/db exec prisma migrate deploy",
    "db:studio": "dotenv -e .env -- pnpm --filter @tapatshop/db exec prisma studio",
    "db:seed": "dotenv -e .env -- tsx packages/db/seed.ts",
    "db:reconcile": "dotenv -e .env -- tsx packages/db/reconcile.ts",
    "db:test:prepare": "dotenv -e .env -v DATABASE_URL=mysql://tapat:password@localhost:3306/tapatshop_test -- pnpm --filter @tapatshop/db exec prisma migrate deploy",
    "db:reset": "dotenv -e .env -- pnpm --filter @tapatshop/db exec prisma migrate reset --force --skip-generate && pnpm db:seed",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:reset": "docker compose -f docker/docker-compose.yml down -v",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  }
}
